    { "button", "Rejoin server", function()
        teleport:TeleportToPlaceInstance(game.PlaceId, game.JobId, players.LocalPlayer)
    end },
    { "button", "Server hop", function()
        local http = game:GetService("HttpService")
        local ok, body = pcall(function()
            return request({
                Url = "https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100",
            }).Body
        end)
        assert(ok and body, "HttpGet failed - enable http requests")
        local okJson, data = pcall(function()
            return http:JSONDecode(body)
        end)
        assert(okJson and data and data.data, "Server list unavailable")
        for _, server in ipairs(data.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                teleport:TeleportToPlaceInstance(game.PlaceId, server.id, players.LocalPlayer)
                return
            end
        end
        Flux.notify("Server hop", "No open server found", 4)
    end },
    { "button", "Copy Discord invite", function()
        setclipboard(Flux.Discord)
        Flux.notify("Discord", "Invite copied", 3)
    end },
})

