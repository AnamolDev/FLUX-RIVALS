local FLUX_LOGO_B64 = ""

local B64_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
local B64_VALUE = table.create(256)
for index = 1, 64 do
    B64_VALUE[string.byte(B64_CHARS, index)] = index - 1
end

local function base64Decode(data)
    local length = #data
    local groups = math.floor(length / 4)
    local out = table.create(groups * 3 + 3)
    local count = 0
    for group = 0, groups - 1 do
        local offset = group * 4
        local a = B64_VALUE[string.byte(data, offset + 1)]
        local b = B64_VALUE[string.byte(data, offset + 2)]
        local c = B64_VALUE[string.byte(data, offset + 3)]
        local d = B64_VALUE[string.byte(data, offset + 4)]
        if a and b and c and d then
            local packed = a * 262144 + b * 4096 + c * 64 + d
            count = count + 1
            out[count] = string.char(math.floor(packed / 65536) % 256, math.floor(packed / 256) % 256, packed % 256)
        end
    end
    return table.concat(out)
end

local function fluxLogoAsset()
    local wrote = pcall(function()
        if not isfolder(Flux.Folder) then
            makefolder(Flux.Folder)
        end
        writefile(Flux.LogoFile, base64Decode(FLUX_LOGO_B64))
    end)
    if not wrote then
        return nil
    end
    local ok, asset = pcall(getcustomasset, Flux.LogoFile)
    if ok and typeof(asset) == "string" and #asset > 0 then
        return asset
    end
    return nil
end

Flux.Logo = fluxLogoAsset()

-- Obsidian renders the window icon through its own asset registry, which only accepts
-- rbxassetid/content/rbxasset prefixes. A local asset id from some executors does not match,
-- so paint the title-bar image directly instead of losing the emblem.
function Flux.PaintLogo(window)
    if not Flux.Logo or not window or not window.MainFrame then
        return
    end
    pcall(function()
        local title = window.MainFrame:FindFirstChild("TitleHolder", true)
        local icon = title and title:FindFirstChildOfClass("ImageLabel")
            or window.MainFrame:FindFirstChild("Icon", true)
        if icon then
            icon.Image = Flux.Logo
            icon.ImageColor3 = Color3.new(1, 1, 1)
            icon.BackgroundTransparency = 1
        end
    end)
end

function Flux.notify(title, text, duration)
    local library = Flux.Library
    if not library then
        return
    end
    pcall(function()
        library:Notify({
            Title = tostring(title or Flux.Brand),
            Description = tostring(text or ""),
            Time = tonumber(duration) or 5,
        })
    end)
end

function Flux.warn(source, message)
    warn(("[Flux %s] %s"):format(tostring(source), tostring(message)))
end

-- Runs a control callback, reports the failure in the menu instead of killing the thread.
function Flux.guard(action, source)
    return function(...)
        local ok, err = pcall(action, ...)
        if not ok then
            Flux.warn(source or "control", err)
            Flux.notify("Error", tostring(source or "control") .. ": " .. tostring(err), 6)
        end
    end
end

