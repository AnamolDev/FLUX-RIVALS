local function applySkybox(name)
    if not flags.world_skybox_enabled then
        if fluxState.ActiveSkybox then
            pcall(function() fluxState.ActiveSkybox:Destroy() end)
            fluxState.ActiveSkybox = nil
        end
        if fluxState.OriginalSkybox then
            pcall(function() fluxState.OriginalSkybox.Parent = Lighting end)
        end
        return
    end

    local preset = SKYBOX_PRESETS[name]
    if not preset then return end

    if not fluxState.ActiveSkybox or not fluxState.ActiveSkybox.Parent then
        local oldSky = Lighting:FindFirstChildOfClass("Sky")
        if oldSky and oldSky.Name ~= "_FluxSky" then
            fluxState.OriginalSkybox = oldSky
            oldSky.Parent = nil
        end
        local newSky = Instance.new("Sky")
        newSky.Name = "_FluxSky"
        newSky.Parent = Lighting
        fluxState.ActiveSkybox = newSky
    end

    local sky = fluxState.ActiveSkybox
    for prop, val in pairs(preset) do
        pcall(function() sky[prop] = val end)
    end
end

local strippedTextures = {}
local textureSweepNext = 0
local function updateNoTextures()
    -- GetDescendants over the whole workspace is the expensive half of this feature, and doing it
    -- sixty times a second is what the strip was meant to avoid. DescendantAdded is not needed:
    -- a decal that appears between sweeps lands at most half a second late.
    local sweepNow = os.clock()
    if flags.world_no_textures and sweepNow < textureSweepNext then
        return
    end
    textureSweepNext = sweepNow + 0.5
    if flags.world_no_textures then
        for _, obj in ipairs(Workspace:GetDescendants()) do
            if obj:IsA("Texture") or obj:IsA("Decal") then
                if not strippedTextures[obj] then
                    strippedTextures[obj] = obj.Transparency
                    obj.Transparency = 1
                end
            end
        end
    elseif next(strippedTextures) ~= nil then
        for obj, origTrans in pairs(strippedTextures) do
            if obj and obj.Parent then
                pcall(function() obj.Transparency = origTrans end)
            end
        end
        table.clear(strippedTextures)
    end
end

-- Performance rewrite of the world/lighting tick.
--
-- The original wrote every Lighting property, the colour-correction effect and the atmosphere
-- on each RenderStepped whether or not a visual feature was on. Each Lighting write dirties the
-- whole render pipeline, which is what crawls on a low-end machine. Writes now happen only when
-- the value actually changes, and the two effect instances are cached instead of searched for.
local lightingWritten = {}
local function putLighting(key, value)
    if value == nil or lightingWritten[key] == value then
        return
    end
    lightingWritten[key] = value
    pcall(function()
        Lighting[key] = value
    end)
end

local ccEffect, atmEffect
local ccWritten, atmWritten = {}, {}

local function resolveEffect(className, effectName)
    local found = Lighting:FindFirstChild(effectName)
    if found and found:IsA(className) then
        return found
    end
    local created = Instance.new(className)
    created.Name = effectName
    created.Parent = Lighting
    return created
end

local function putEffect(cache, effect, key, value)
    if cache[key] == value then
        return
    end
    cache[key] = value
    pcall(function()
        effect[key] = value
    end)
end

local hazardScanNext = 0

local function updateWorldLighting(dt)
    if flags.lighting_ambient_enabled then
        putLighting("Ambient", flags.lighting_ambient_color or Color3.fromRGB(150, 150, 150))
    elseif originalLightingProps.Ambient ~= nil then
        putLighting("Ambient", originalLightingProps.Ambient)
    end

    if flags.lighting_outdoor_ambient_enabled then
        putLighting("OutdoorAmbient", flags.lighting_outdoor_ambient_color or Color3.fromRGB(120, 120, 140))
    elseif originalLightingProps.OutdoorAmbient ~= nil then
        putLighting("OutdoorAmbient", originalLightingProps.OutdoorAmbient)
    end

    if flags.lighting_brightness_enabled then
        putLighting("Brightness", flags.lighting_brightness_value or 2)
    elseif originalLightingProps.Brightness ~= nil then
        putLighting("Brightness", originalLightingProps.Brightness)
    end

    if flags.lighting_clocktime_enabled then
        putLighting("ClockTime", flags.lighting_clocktime_value or 14)
    elseif flags.world_sky_autorotate then
        -- Genuinely animated: this one has to run every frame.
        local speed = (flags.world_sky_rotate_speed or 100) / 100
        Lighting.ClockTime = (Lighting.ClockTime + (dt * speed)) % 24
        lightingWritten.ClockTime = nil
    elseif originalLightingProps.ClockTime ~= nil then
        putLighting("ClockTime", originalLightingProps.ClockTime)
    end

    if flags.lighting_fog_enabled then
        putLighting("FogColor", flags.lighting_fog_color or Color3.fromRGB(160, 160, 180))
        putLighting("FogStart", flags.lighting_fog_start or 0)
        putLighting("FogEnd", flags.lighting_fog_end or 1000)
    elseif flags.world_no_fog then
        putLighting("FogStart", 0)
        putLighting("FogEnd", 1000000)
    elseif originalLightingProps.FogColor ~= nil then
        putLighting("FogColor", originalLightingProps.FogColor)
        putLighting("FogStart", originalLightingProps.FogStart)
        putLighting("FogEnd", originalLightingProps.FogEnd)
    end

    if flags.lighting_shadows_enabled ~= nil then
        putLighting("GlobalShadows", flags.lighting_shadows_enabled)
        if flags.lighting_shadow_softness then
            putLighting("ShadowSoftness", flags.lighting_shadow_softness)
        end
    end

    if flags.lighting_exposure_enabled then
        putLighting("ExposureCompensation", flags.lighting_exposure_value or 0)
    elseif originalLightingProps.ExposureCompensation ~= nil then
        putLighting("ExposureCompensation", originalLightingProps.ExposureCompensation)
    end

    if flags.lighting_technology_enabled and flags.lighting_technology then
        local tech = Enum.Technology[flags.lighting_technology]
        if tech then
            putLighting("Technology", tech)
        end
    end

    if flags.color_correction_enabled then
        if not ccEffect or not ccEffect.Parent then
            ccEffect = resolveEffect("ColorCorrectionEffect", "_FluxColorCorrection")
            ccWritten = {}
        end
        putEffect(ccWritten, ccEffect, "TintColor", flags.cc_tint_color or Color3.fromRGB(255, 255, 255))
        putEffect(ccWritten, ccEffect, "Saturation", flags.cc_saturation or 0)
        putEffect(ccWritten, ccEffect, "Contrast", flags.cc_contrast or 0)
        putEffect(ccWritten, ccEffect, "Brightness", flags.cc_brightness or 0)
        putEffect(ccWritten, ccEffect, "Enabled", true)
    elseif ccEffect and ccEffect.Enabled then
        ccEffect.Enabled = false
    end

    if flags.atmosphere_enabled then
        if not atmEffect or not atmEffect.Parent then
            atmEffect = resolveEffect("Atmosphere", "_FluxAtmosphere")
            atmWritten = {}
        end
        putEffect(atmWritten, atmEffect, "Color", flags.atmosphere_color or Color3.fromRGB(199, 170, 107))
        putEffect(atmWritten, atmEffect, "Decay", flags.atmosphere_decay or Color3.fromRGB(106, 112, 125))
        putEffect(atmWritten, atmEffect, "Density", flags.atmosphere_density or 0.3)
        putEffect(atmWritten, atmEffect, "Haze", flags.atmosphere_haze or 1)
        putEffect(atmWritten, atmEffect, "Glare", flags.atmosphere_glare or 0)
    elseif atmEffect then
        local dying = atmEffect
        atmEffect = nil
        pcall(function()
            dying:Destroy()
        end)
    end

    updateNoTextures()

    local now = os.clock()
    if now >= hazardScanNext and (flags.anti_flash or flags.anti_shake) then
        hazardScanNext = now + 0.25
        if flags.anti_flash then
            pcall(function()
                local flash = Lighting:FindFirstChild("Flashbang") or Camera:FindFirstChild("Flashbang")
                if flash then
                    flash:Destroy()
                end
            end)
        end
        if flags.anti_shake then
            pcall(function()
                local shake = Camera:FindFirstChild("CameraShake") or Camera:FindFirstChild("Shake")
                if shake then
                    shake:Destroy()
                end
            end)
        end
    end
end
local PagesModule
local ItemLibModule
pcall(function()
    local ps = LocalPlayer:FindFirstChild("PlayerScripts") or LocalPlayer:WaitForChild("PlayerScripts", 0.5)
    if ps and ps:FindFirstChild("Modules") then
        local uiMod = ps.Modules:FindFirstChild("UserInterface")
        if uiMod and uiMod:FindFirstChild("Pages") then
            PagesModule = require(uiMod.Pages)
        end
    end
end)
pcall(function()
    local rep = game:GetService("ReplicatedStorage")
    if rep:FindFirstChild("Modules") and rep.Modules:FindFirstChild("ItemLibrary") then
        ItemLibModule = require(rep.Modules.ItemLibrary)
    end
end)

local autoLoadoutFinished = false
local function runAutoLoadout()
    if not flags.auto_loadout_enabled then return end
    if not PagesModule or not PagesModule.PageSystem then return end

    local currentPage = PagesModule.PageSystem.CurrentPage
    if currentPage and currentPage.Name == "PickWeapons" then
        local slotMap = {
            Primary   = 1,
            Secondary = 2,
            Melee     = 3,
            Utility   = 4,
        }
        local weaponChoices = {
            Primary   = flags.auto_loadout_primary or "Assault Rifle",
            Secondary = flags.auto_loadout_secondary or "Handgun",
            Melee     = flags.auto_loadout_melee or "Fists",
            Utility   = flags.auto_loadout_utility or "Grenade",
        }

        for slotName, weaponName in pairs(weaponChoices) do
            local slotId = slotMap[slotName]
            if slotId and weaponName then
                local oldId = getthreadidentity and getthreadidentity() or 7
                if type(setthreadidentity) == "function" then pcall(function() setthreadidentity(2) end) end
                if currentPage and type(currentPage.PickWeapon) == "function" then pcall(function() currentPage:PickWeapon(slotId, weaponName) end) end
                if type(setthreadidentity) == "function" then pcall(function() setthreadidentity(oldId) end) end
            end
        end

        if flags.auto_loadout_finish and not autoLoadoutFinished then
            autoLoadoutFinished = true
            task.spawn(function()
                task.wait(0.12)
                pcall(function() currentPage:Finish() end)
            end)
        end
    else
        autoLoadoutFinished = false
    end
end

local function runAutoQueue()
    if not flags.auto_queue_enabled then return end
    if not PagesModule or not PagesModule.PageSystem then return end

    local currentPage = PagesModule.PageSystem.CurrentPage
    if currentPage and currentPage.Name == "GameOver" then
        pcall(function()
            if currentPage.PlayAgain then
                currentPage:PlayAgain()
            elseif currentPage.Queue then
                currentPage:Queue()
            end
        end)
    end
end

local function runBunnyHop()
    if not movementState.BHopEnabled then return end
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if hum and hum.FloorMaterial ~= Enum.Material.Air then
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
    end
end

local statusWanted, statusNext = nil, 0
local function runSpoofers()
    local want = flags.status_spoof_enabled and flags.status_spoof_value or nil
    local now = os.clock()
    if want == statusWanted and now < statusNext then return end
    statusWanted = want
    statusNext = now + 1
    if want then
        pcall(function()
            LocalPlayer:SetAttribute("PlayerStatus", want)
        end)
    end
end

-- runCombatAimbot lived here; the aim engine below turns the camera on RenderStepped.

local function runMeleeAura()
    if not flags.knife_rage then return end
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local now = os.clock()
    if now - fluxState.LastMeleeAttack < 0.12 then return end

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and pl.Character then
            local root = pl.Character:FindFirstChild("HumanoidRootPart")
            local hum = pl.Character:FindFirstChildOfClass("Humanoid")
            if root and hum and hum.Health > 0 then
                local dist = (root.Position - myRoot.Position).Magnitude
                if dist <= (flags.melee_safe_reach or 12) then
                    fluxState.LastMeleeAttack = now
                    pcall(function()
                        if flags.melee_auto_face_back ~= false then
                            myRoot.CFrame = CFrame.new(myRoot.Position, myRoot.Position - root.CFrame.LookVector)
                        end
                        local tool = myChar:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                    end)
                    break
                end
            end
        end
    end
end

local function runAntiAim()
    if not flags.antiaim_enabled then return end
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local pitchVal = antiaim_pitch(flags.antiaim_pitch, flags.antiaim_custom_pitch)
    local yawVal = antiaim_yaw(flags.antiaim_yaw, flags.antiaim_spin_speed, flags.antiaim_jitter_range)

    pcall(function()
        local baseLook = Camera.CFrame.LookVector
        local baseAngle = math.atan2(-baseLook.X, -baseLook.Z)
        local rot = CFrame.Angles(0, baseAngle + math.rad(yawVal), 0) * CFrame.Angles(math.rad(pitchVal), 0, 0)
        root.CFrame = CFrame.new(root.Position) * rot
    end)
end

local function updateCameraAndWorld(dt)

    if flags.third_person then
        pcall(function()
            local char = LocalPlayer.Character
            if char and LocalPlayer.CameraMode ~= Enum.CameraMode.Classic then
                LocalPlayer.CameraMode = Enum.CameraMode.Classic
            end
        end)
    end

    if flags.camera_fov_enabled and Camera then
        if not fluxState.OriginalCameraFov then
            fluxState.OriginalCameraFov = Camera.FieldOfView
        end
        Camera.FieldOfView = flags.camera_fov or 90
    elseif fluxState.OriginalCameraFov and Camera then
        Camera.FieldOfView = fluxState.OriginalCameraFov
        fluxState.OriginalCameraFov = nil
    end

    -- the sky autorotate and the flashbang sweep live in updateWorldLighting now
end

--[[
    Boost FPS.

    Quality level, shadows, post effects, and everything the map decorates its parts with. The
    sweep has to walk the whole data model, which is far too much for one frame on exactly the
    machines this feature exists for, so the work is queued and drained a few hundred instances at a
    time. Every property written is remembered, so switching it back off hands the map its look
    again instead of leaving it half-stripped.
]]

local fpsState = {
    on = false,
    queue = nil,
    head = 0,
    sweep = nil,
    added = nil,
    saved = setmetatable({}, { __mode = "k" }),
    quality = nil,
    shadows = nil,
}

local FPS_SWEEP_BUDGET = 400

-- IsA is a namecall, and every namecall in the game walks the hub's aim hook; a sweep that asks a
-- class question four times per instance spends most of its frame inside that hook. ClassName is a
-- plain property read, and the classes worth touching are a short enumerable list, so the lookup
-- costs one table read for the overwhelming majority of the data model.
local fpsKind = {
    BasePart = "part",
    Part = "part",
    MeshPart = "part",
    SpawnLocation = "part",
    UnionOperation = "part",
    Decal = "flat",
    Texture = "flat",
    Explosion = "blast",
    ParticleEmitter = "quiet",
    Trail = "quiet",
    Beam = "quiet",
    BloomEffect = "quiet",
    ColorCorrectionEffect = "quiet",
    BlurEffect = "quiet",
    DepthOfField = "quiet",
    SunRaysEffect = "quiet",
}

-- The first value seen wins: a part re-added under a new emitter must not overwrite the
-- original look with the stripped one.
local function fpsKeep(obj, key, value)
    local entry = fpsState.saved[obj]
    if not entry then
        entry = {}
        fpsState.saved[obj] = entry
    end
    if entry[key] == nil then
        entry[key] = value
    end
end

local function fpsApply(v)
    local kind = fpsKind[v.ClassName]
    if kind == "part" then
        if v.Material ~= Enum.Material.Plastic then
            fpsKeep(v, "Material", v.Material)
            v.Material = Enum.Material.Plastic
        end
        if v.Reflectance > 0 then
            fpsKeep(v, "Reflectance", v.Reflectance)
            v.Reflectance = 0
        end
    elseif kind == "flat" then
        if v.Transparency < 1 then
            fpsKeep(v, "Transparency", v.Transparency)
            v.Transparency = 1
        end
    elseif kind == "blast" then
        if v.Visible then
            fpsKeep(v, "Visible", true)
            v.Visible = false
        end
    elseif kind == "quiet" then
        if v.Enabled then
            fpsKeep(v, "Enabled", true)
            v.Enabled = false
        end
    end
end

local function fpsStrip(v)
    pcall(fpsApply, v)
end

local function fpsFinishSweep()
    fpsState.queue = nil
    fpsState.head = 0
    local conn = fpsState.sweep
    fpsState.sweep = nil
    pcall(function()
        conn:Disconnect()
    end)
end

local function fpsSweepStep()
    local queue = fpsState.queue
    if not queue then
        fpsFinishSweep()
        return
    end
    local total = #queue
    local index = fpsState.head
    local budget = FPS_SWEEP_BUDGET
    while budget > 0 and index < total do
        index = index + 1
        budget = budget - 1
        fpsStrip(queue[index])
    end
    fpsState.head = index
    if index >= total then
        fpsFinishSweep()
    end
end

local function fpsBoostDisable()
    fpsState.on = false
    fpsFinishSweep()
    local added = fpsState.added
    fpsState.added = nil
    pcall(function()
        added:Disconnect()
    end)
    for obj, entry in pairs(fpsState.saved) do
        for key, value in pairs(entry) do
            pcall(function()
                obj[key] = value
            end)
        end
    end
    table.clear(fpsState.saved)
    if fpsState.quality ~= nil then
        local level = fpsState.quality
        fpsState.quality = nil
        pcall(function()
            settings().Rendering.QualityLevel = level
        end)
    end
    if fpsState.shadows ~= nil then
        local shadows = fpsState.shadows
        fpsState.shadows = nil
        pcall(function()
            Lighting.GlobalShadows = shadows
        end)
    end
end

local function fpsBoostEnable()
    pcall(function()
        fpsState.quality = settings().Rendering.QualityLevel
        settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
    end)
    pcall(function()
        fpsState.shadows = Lighting.GlobalShadows
        Lighting.GlobalShadows = false
    end)
    pcall(function()
        fpsState.queue = game:GetDescendants()
        fpsState.head = 0
        fpsState.sweep = RunService.Heartbeat:Connect(fpsSweepStep)
    end)
    pcall(function()
        fpsState.added = game.DescendantAdded:Connect(fpsStrip)
    end)
end

local function setFpsBoost(value)
    value = value and true or false
    if value == fpsState.on then
        return fpsState.on
    end
    fpsState.on = value
    if value then
        fpsBoostEnable()
    else
        fpsBoostDisable()
    end
    return fpsState.on
end

--[[
    Aim application.

    Rivals decides a hit on the client and tells the server what it decided, so an aim has to
    speak where the game looks. Four places carry the answer, and all four are bent to the same
    point the frame the target is locked:

      * GameplayUtility:GetEntitiesFromRaycast - the game's own entity ray query, which is what
        a gun actually hits with. This is the one that makes a silent shot register.
      * workspace:Raycast and the legacy FindPartOnRay forms - the tracer and the impact maths.
      * the FireServer payload - Origin/Direction for the weapons that replicate a raw ray.

    Bending only workspace:Raycast is why a silent aim looks dead in this game: the shot is
    resolved by the entity query, and the ray the client draws is a separate call.

    The visible aimbot has a rule of its own. Rivals rebuilds the camera every frame from the
    controller in PlayerScripts.Controllers.CameraController, so writing Camera.CFrame alone is
    a suggestion it overwrites. The controller's MimicRotation adopts the turn as its own, which
    is what lets the aim accumulate instead of snapping back.
]]

local fluxCaller = checkcaller or function()
    return false
end

local aimState = {
    silentPos = nil, -- where the next shot points; refreshed once a frame, read by the hooks
    scanning = false, -- the hub's own probe raycasts must not be bent by the hub
    lock = nil, -- the player the aim is committed to, so the aim does not hop between two bodies
}

-- Within this cone the camera is already on the target; correcting again is the jitter that
-- reads as an aim which cannot settle.
local aimDeadzone = math.cos(math.rad(0.15))

-- Rivals' own modules. Requiring a ModuleScript can yield and this runs from the render loop,
-- so the lookup happens once on a spawned thread and the aim simply waits for it.
local aimRival = {
    status = "idle",
    retryAt = 0,
    gameplay = nil,
    camera = nil,
    fighter = nil,
}

local function aimCamera()
    -- Workspace.CurrentCamera is replaced whenever the character resets, so the capture made
    -- at load goes stale and every aim reading after it points at a dead camera.
    local live = Workspace.CurrentCamera
    if live and live ~= Camera then
        Camera = live
    end
    return live or Camera
end

local function aimRequire(instance)
    if not instance then
        return nil
    end
    local ok, result = pcall(require, instance)
    if ok then
        return result
    end
    return nil
end

-- The entity query takes (state, state, state, origin, direction, distance, ...). Anything whose
-- origin is not a vector is not the shot, so a renamed or reshaped call is left alone rather than
-- corrupted.
local function aimInstallEntityBend()
    local gameplay = aimRival.gameplay
    local original = gameplay and gameplay.GetEntitiesFromRaycast
    if type(original) ~= "function" or gameplay.__fluxSilent then
        return
    end
    gameplay.__fluxSilent = true
    gameplay.GetEntitiesFromRaycast = function(a1, a2, a3, origin, direction, distance, ...)
        local bent = aimState.silentPos
        if bent ~= nil and typeof(origin) == "Vector3" then
            local to = bent - origin
            local reach = to.Magnitude
            if reach > 0.001 then
                direction = to / reach
                if type(distance) == "number" and reach > distance then
                    distance = reach + 5
                end
            end
        end
        return original(a1, a2, a3, origin, direction, distance, ...)
    end
end

local function aimResolveRival()
    local now = os.clock()
    if aimRival.status == "ready" or aimRival.status == "working" or now < aimRival.retryAt then
        return
    end
    aimRival.status = "working"
    task.spawn(function()
        pcall(function()
            local mods = game:GetService("ReplicatedStorage"):FindFirstChild("Modules")
            if mods then
                aimRival.gameplay = aimRequire(mods:FindFirstChild("GameplayUtility"))
            end
            local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
            local controllers = scripts and scripts:FindFirstChild("Controllers")
            if controllers then
                aimRival.camera = aimRequire(controllers:FindFirstChild("CameraController"))
                aimRival.fighter = aimRequire(controllers:FindFirstChild("FighterController"))
            end
        end)
        if aimRival.gameplay or aimRival.camera or aimRival.fighter then
            aimRival.status = "ready"
            aimInstallEntityBend()
        else
            -- Not in a match yet: the modules arrive with the game, so ask again shortly.
            aimRival.status = "idle"
            aimRival.retryAt = os.clock() + 3
        end
    end)
end

-- ───────────────────────── shot packets ─────────────────────────
-- Rivals renames its gun remotes between updates, so a name list goes stale and the feature
-- reads as dead. A shot is recognised by its shape instead: a Direction vector is what walks the
-- ray, and the known names are no longer needed to trust the payload.

local function flattenSpread(payload)
    local spread = payload.Spread
    if typeof(spread) == "Vector3" then
        payload.Spread = Vector3.zero
    elseif type(spread) == "number" then
        payload.Spread = 0
    end
    if type(payload.SpreadAngle) == "number" then
        payload.SpreadAngle = 0
    end
end

-- True when the payload was a shot and got pointed at the target, so the walk can stop.
local function bendShot(payload, origin, bent, noSpread)
    if type(payload) ~= "table" then
        return false
    end
    if noSpread then
        flattenSpread(payload)
        local effect = payload._ProjectileEffect
        if type(effect) == "table" then
            flattenSpread(effect)
        end
    end
    local key, dir = "Direction", payload.Direction
    if dir == nil then
        key, dir = "direction", payload.direction
    end
    if bent == nil or not (typeof(dir) == "Vector3") then
        return false
    end
    -- The length is the weapon's own range; only the heading belongs to the aim.
    payload[key] = (bent - origin).Unit * dir.Magnitude
    if payload.Origin ~= nil then
        payload.Origin = origin
    elseif payload.origin ~= nil then
        payload.origin = origin
    end
    return true
end

-- The walk lives apart from the caller because a nested function cannot read the enclosing
-- varargs, and `...` here is the whole point: the arguments are handed over on the call stack.
local function aimBendWalk(count, origin, bent, noSpread, ...)
    for index = 1, count do
        if bendShot((select(index, ...)), origin, bent, noSpread) then
            return
        end
    end
end

-- Rivals puts the shot payload a few arguments into a remote call, and this runs inside every
-- FireServer the game makes. The arguments are walked with `select` rather than copied into a table
-- first: an argument table per call is an allocation on every remote the game raises, shots or not,
-- and `select("#", ...)` counts the nil holes that a `#` on a copied table would stop at.
local function aimPacketHit(...)
    local bent = aimState.silentPos
    local noSpread = flags.silent_no_spread == true
    if bent == nil and not noSpread then
        return
    end

    local origin = aimCamera().CFrame.Position
    if fakePos.Enabled and fakePos.VirtualCF then
        origin = fakePos.VirtualCF.Position
    end

    pcall(aimBendWalk, select("#", ...), origin, bent, noSpread, ...)
end

-- ───────────────────────── target choice ─────────────────────────
local aimProbe = RaycastParams.new()
aimProbe.FilterType = Enum.RaycastFilterType.Exclude

-- A re-execution between respawns has no character yet, and the property refuses a list with a
-- hole in it - so the filter is rebuilt from whatever exists and never assigned bare.
local function aimFilterFor(char)
    local ignore = {}
    if char then
        table.insert(ignore, char)
    end
    if Camera then
        table.insert(ignore, Camera)
    end
    pcall(function()
        aimProbe.FilterDescendantsInstances = ignore
    end)
end

aimFilterFor(LocalPlayer.Character)
LocalPlayer.CharacterAdded:Connect(aimFilterFor)

local function aimProbeClear(root)
    local parent = root.Parent
    if not parent then return true end
    local from = aimCamera().CFrame.Position
    local delta = root.Position - from
    if delta.Magnitude < 0.5 then return true end
    local hit = Workspace:Raycast(from, delta, aimProbe)
    if not hit or not hit.Instance then return true end
    if hit.Instance:IsDescendantOf(parent) then return true end
    local me = LocalPlayer.Character
    return me ~= nil and hit.Instance:IsDescendantOf(me)
end

-- A probe that cannot answer (a part destroyed mid-frame) reads as a clear shot: a wrong
-- "blocked" looks exactly like a feature that does nothing.
local function aimIsVisible(root)
    local ok, clear = pcall(aimProbeClear, root)
    if not ok then return true end
    return clear == true
end

-- A player behind the camera projects to a screen point right beside the crosshair, which is how
-- an aim ends up firing backwards and the shot goes nowhere.
local function aimOnScreen(root)
    local ok, visible = pcall(function()
        local _, onScreen = aimCamera():WorldToViewportPoint(root.Position)
        return onScreen
    end)
    return (not ok) or visible ~= false
end

-- A shot takes time to fly and the camera has to travel to catch up with a running target, so
-- aiming where they are is already a miss. The slider decides how much of that gap is paid for.
local function aimLeadPoint(target)
    local dest = target.HitPart.Position
    local percent = flags.aimbot_lead or 0
    if percent <= 0 then
        return dest
    end
    local root = target.RootPart
    local vel = root.AssemblyLinearVelocity
    if vel == nil then
        vel = root.Velocity
    end
    if vel == nil then
        return dest
    end
    return dest + vel * (percent / 100 * 0.35)
end

-- The scan ranks the whole roster by the priority setting, so two players standing together make
-- it swap every few frames and the aim reads as undecided. The locked player is re-read on their
-- own and keeps the aim while they are alive, on screen and inside the reach already agreed to.
local function aimHeldRecord(pl, reach)
    local char = pl and pl.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or hum.Health <= 0 then return nil end
    local cam = aimCamera()
    local scr, onScreen = cam:WorldToViewportPoint(root.Position)
    if not onScreen then return nil end
    local center = cam.ViewportSize / 2
    local dist = (Vector2.new(scr.X, scr.Y) - center).Magnitude
    if dist > reach then return nil end
    local hit = silent_closest_hitbox(char)
    if not hit then return nil end
    return {
        Player = pl,
        Character = char,
        RootPart = root,
        HitPart = hit,
        FOVDistance = dist,
    }
end

-- Walking the roster is the most expensive thing the hub does in a frame, and two callers want its
-- answer: the visuals on Heartbeat and the aim on RenderStepped. Whichever is switched on owns that
-- frame's scan, so an armed aimbot never pays for the walk twice.
local function aimWantsScan()
    return flags.silent_aim_enabled == true
        or (flags.aimbot_enabled == true and flags.aimbot_active == true)
end

-- The latch covers the walk whichever caller runs it: scanning the roster shoots its own shield
-- probes, and a probe answered from the last silent-aim target reports cover for the wrong ray.
local function aimScan()
    if aimWantsScan() then
        return fluxState.CurrentTarget
    end
    aimState.scanning = true
    local ok, target = pcall(get_target)
    aimState.scanning = false
    return ok and target or nil
end

local function aimTick(dt)
    local wantSilent = flags.silent_aim_enabled == true
    local wantAim = flags.aimbot_enabled == true and flags.aimbot_active == true
    if not wantSilent and not wantAim then
        aimState.silentPos = nil
        aimState.lock = nil
        return
    end

    aimResolveRival()

    -- Each feature keeps its own reach; the scan runs to whichever of them looks furthest.
    local silentReach = flags.silent_aim_anywhere and math.huge or (flags.fov_radius_smoothed or 300)
    local aimReach = flags.aimbot_radius_smoothed or 180
    local reach = wantSilent and silentReach or aimReach
    if wantSilent and wantAim and aimReach > reach then
        reach = aimReach
    end

    aimState.scanning = true
    local target = get_target(true)
    if target and not aimOnScreen(target.RootPart) then
        target = nil
    end
    if not target or target.Player ~= aimState.lock then
        local held = aimHeldRecord(aimState.lock, reach)
        if held then
            target = held
        end
    end
    aimState.lock = target and target.Player or nil

    local placed, turnOn = nil, nil
    if target and target.HitPart and target.RootPart then
        -- The scan widens its circle to whichever feature reaches further; each one then keeps
        -- its own radius, so a wide aimbot circle cannot drag silent aim out to the same range.
        local distance = target.FOVDistance or 0
        local clear = not (flags.aim_visible_only and not aimIsVisible(target.RootPart))
        if clear then
            local lead = aimLeadPoint(target)
            if wantSilent and distance <= silentReach
                and math.random(1, 100) <= (flags.hit_chance or 100) then
                placed = lead
            end
            if wantAim and distance <= aimReach then
                turnOn = lead
            end
        end
    end

    aimState.scanning = false
    aimState.silentPos = placed

    if not turnOn then
        return
    end

    local cam = aimCamera()
    local from = cam.CFrame
    local pos = from.Position
    local toward = turnOn - pos
    if toward.Magnitude < 0.001 then
        return
    end
    toward = toward / toward.Magnitude
    local fwd = from.LookVector
    if fwd:Dot(toward) >= aimDeadzone then
        return
    end
    -- The slider is the share of the remaining angle closed in a 60fps frame, so it is re-based on
    -- dt and a low-end frame rate turns the same distance per second instead of in bigger steps.
    local smooth = math.clamp((flags.aimbot_snap_speed or 60) / 100, 0.01, 1)
    local alpha = 1 - (1 - smooth) ^ (dt * 60)
    local blended = fwd:Lerp(toward, alpha)
    if blended.Magnitude < 0.001 then
        blended = toward
    else
        blended = blended.Unit
    end
    local look = CFrame.lookAt(pos, pos + blended)
    pcall(function()
        -- The controller owns the camera; without this the turn is redrawn away next frame.
        local controller = aimRival.camera
        if controller and type(controller.MimicRotation) == "function" then
            controller:MimicRotation(look)
        end
        cam.CFrame = look
    end)
end

-- ───────────────────────── trigger bot and rage bot ─────────────────────────
-- Both press the game's own trigger instead of rebuilding a shot packet.
-- FighterController's LocalFighter:Input("StartShooting") is the call a mouse click makes, so the
-- recoil, the ammo, the cooldown and the replicated payload all stay the game's business - and a
-- silent aim that happens to be switched on bends this shot like any other one.
local combat = {
    hot = false,      -- the body the crosshair is already committed to
    probeAt = 0,      -- when the next look is allowed
    rageAt = 0,
    fireAt = 0,
    restoring = false,
    looking = false,  -- a fighter lookup is already in flight
    retryAt = 0,
}

local combatRestoreKey = "FluxRageRestore"

-- The controller arrives with the match, which can be long after the module pass above settled on
-- the replication modules alone. So the bots ask for it themselves, on a spawned thread because a
-- require yields, and wait three seconds before trying again rather than parking the frame.
local function combatFindFighter()
    if combat.looking then
        return
    end
    combat.looking = true
    task.spawn(function()
        local found = nil
        pcall(function()
            local scripts = LocalPlayer:FindFirstChild("PlayerScripts")
            local controllers = scripts and scripts:FindFirstChild("Controllers")
            found = controllers and aimRequire(controllers:FindFirstChild("FighterController")) or nil
        end)
        aimRival.fighter = found
        combat.looking = false
        if not found then
            combat.retryAt = os.clock() + 3
        end
    end)
end

local function combatFighter()
    local controller = aimRival.fighter
    if controller then
        return controller.LocalFighter
    end
    local now = os.clock()
    if now >= combat.retryAt then
        combatFindFighter()
    end
    return nil
end

-- Rivals keeps the squad on a player attribute rather than in a Teams folder, which is why the ESP
-- teammate filter (it reads pl.Team) cannot see it here. A side with no attribute is not a teammate.
local function combatHostile(pl, check)
    if check ~= true then
        return true
    end
    local mine = LocalPlayer:GetAttribute("TeamID")
    if mine == nil then
        return true
    end
    return pl:GetAttribute("TeamID") ~= mine
end

-- The fighter belongs to the game and runs at the server's identity, so the call is made from a
-- lowered thread and the identity is handed back afterwards - including when the call itself fails,
-- which is why the restore cannot live inside the same pcall as the press.
local function combatPress(fighter)
    if type(fighter) ~= "table" or type(fighter.Input) ~= "function" then
        return false
    end
    local previous = nil
    local lowered = false
    if setthreadidentity then
        previous = getthreadidentity and getthreadidentity() or 7
        pcall(setthreadidentity, 2)
        lowered = true
    end
    local ok, fired = pcall(fighter.Input, fighter, "StartShooting")
    if lowered then
        pcall(setthreadidentity, previous)
    end
    return ok and fired ~= false
end

-- What the crosshair is on right now, with the hub's own silent-aim bend held off the ray the same
-- way the target scan holds it off its shield probes: a trigger that fired at whatever the aim was
-- already pointed at would be the aim feature wearing a different name.
local function combatUnderCrosshair(range)
    local origin = aimCamera().CFrame.Position
    local direction = aimCamera().CFrame.LookVector * range
    local character = LocalPlayer.Character
    local ignore = character and { character } or {}
    aimState.scanning = true
    local ok, part = pcall(function()
        return Workspace:FindPartOnRayWithIgnoreList(Ray.new(origin, direction), ignore)
    end)
    aimState.scanning = false
    if not ok or part == nil then
        return nil
    end
    local model = part.Parent
    local owner = model and Players:GetPlayerFromCharacter(model) or nil
    if not owner or owner == LocalPlayer then
        return nil
    end
    local hum = model:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then
        return nil
    end
    return owner
end

local function combatTrigger()
    if flags.triggerbot_enabled ~= true then
        combat.hot = false
        return
    end
    aimResolveRival()
    local now = os.clock()
    if now < combat.probeAt then
        return
    end
    combat.probeAt = now + 0.05

    local enemy = combatUnderCrosshair(flags.triggerbot_range or 500)
    if not enemy or not combatHostile(enemy, flags.triggerbot_team_check) then
        combat.hot = false
        return
    end

    if not combat.hot then
        -- The first frame on a new body is the reaction pause; shooting instantly on lock is what
        -- reads as a bot to anyone watching the kill feed.
        combat.hot = true
        combat.probeAt = now + (flags.triggerbot_reaction or 0.05)
        return
    end

    local fighter = combatFighter()
    if not fighter then
        return
    end
    combat.probeAt = now + (flags.triggerbot_delay or 0.1)
    combatPress(fighter)
end

-- The closest living enemy anywhere in the match, which is a wider question than the aim scan asks:
-- that one only reports bodies inside a circle on the screen.
local function combatNearest(range)
    local character = LocalPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart") or nil
    if not root then
        return nil
    end
    local check = flags.ragebot_team_check
    local best, bestDist = nil, range
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= LocalPlayer and combatHostile(pl, check) then
            local char = pl.Character
            if char then
                local theirs = char:FindFirstChild("HumanoidRootPart")
                local head = char:FindFirstChild("Head")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if theirs and head and hum and hum.Health > 0
                    and not char:FindFirstChildOfClass("ForceField") then
                    local dist = (theirs.Position - root.Position).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        best = { Root = theirs, Head = head }
                    end
                end
            end
        end
    end
    return best
end

-- Stand over the target, shoot from there, and be back where they were before the frame is drawn.
-- The restore runs on the render step after the game has built its shot from the raised position, so
-- the packet leaves from above the target while nothing on screen ever shows the move.
local function combatRage()
    local armed = flags.ragebot_enabled == true and flags.ragebot_active == true
    if not armed then
        return
    end
    aimResolveRival()
    local now = os.clock()
    if now < combat.rageAt then
        return
    end
    combat.rageAt = now + 0.05

    local target = combatNearest(flags.ragebot_range or 500)
    if not target then
        return
    end

    local root = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local fighter = combatFighter()
    if not root or not fighter then
        return
    end

    local over = target.Root.Position
    if flags.ragebot_prediction == true then
        local velocity = target.Root.AssemblyLinearVelocity
        local speed = velocity.Magnitude
        if speed > 0.35 then
            over += velocity * math.clamp(0.08 + speed * 0.006, 0.06, 0.4)
        end
    end
    local height = flags.ragebot_height or 3
    -- Two studs off the body's own axis, which is the gap the shot needs to clear their hitbox.
    local perch = Vector3.new(over.X, over.Y + height, over.Z + 2)
    local look = CFrame.lookAt(perch, target.Head.Position)

    local was = root.CFrame
    local linear = root.AssemblyLinearVelocity
    local angular = root.AssemblyAngularVelocity
    local ok = pcall(function()
        root.CFrame = look
    end)
    if not ok then
        return
    end

    if not combat.restoring then
        combat.restoring = true
        pcall(function()
            RunService:BindToRenderStep(combatRestoreKey, 101, function()
                -- The character can die between the step and the restore, and a write that throws
                -- here would otherwise leave the key bound and the bot latched off for the match.
                pcall(function()
                    root.CFrame = was
                    root.AssemblyLinearVelocity = linear
                    root.AssemblyAngularVelocity = angular
                end)
                combat.restoring = false
                pcall(function()
                    RunService:UnbindFromRenderStep(combatRestoreKey)
                end)
            end)
        end)
    end

    if now >= combat.fireAt then
        combat.fireAt = now + (flags.ragebot_fire_delay or 0.12)
        combatPress(fighter)
    end
end

local function combatFrame()
    combatTrigger()
    combatRage()
end
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    -- Every Instance call in the game walks through here, so nothing below runs for a method this
    -- hook does not act on, and the paths that do run read their arguments without copying them.
    if method == "FireServer" then
        if flags.silent_aim_enabled or flags.silent_no_spread then
            aimPacketHit(...)
        end
    elseif flags.silent_aim_enabled and self == Workspace and aimState.silentPos
        and not aimState.scanning and not fluxCaller() then
        -- The client rays are the tracer and the impact maths; they follow the same bent point so
        -- what is drawn matches what lands.
        local bent = aimState.silentPos
        local args = table.pack(...)
        if method == "Raycast" then
            -- Only Workspace:Raycast here - the legacy FindPartOnRay forms carry a Ray in slot one
            -- and rewriting that slot as a vector corrupts the caller instead of the aim.
            local origin = args[1]
            local direction = args[2]

            if fakePos.Enabled and fakePos.VirtualCF then
                origin = fakePos.VirtualCF.Position
                args[1] = origin
            end
            if typeof(origin) == "Vector3" and typeof(direction) == "Vector3" then
                args[2] = (bent - origin).Unit * direction.Magnitude
                if fakePos.Enabled and fakePos.AutoHandoff then
                    fakePos.HandoffTicks = 2
                end
                return oldNamecall(self, table.unpack(args, 1, args.n))
            end
        elseif method == "FindPartOnRay" or method == "FindPartOnRayWithIgnoreList"
            or method == "FindPartOnRayWithIgnoreMap" or method == "FindPartOnRayWithHostList" then
            local ray = args[1]
            local origin, span = ray and ray.Origin, ray and ray.Direction
            if origin and span then
                args[1] = Ray.new(origin, (bent - origin).Unit * span.Magnitude)
                return oldNamecall(self, table.unpack(args, 1, args.n))
            end
        end
    end

    return oldNamecall(self, ...)
end)

