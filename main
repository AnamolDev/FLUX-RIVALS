right(settings, "Session", "info", {
    { "label", Flux.Brand .. "  v" .. Flux.Version },
    { "label", "Interface: deividcomsono/Obsidian" },
    { "button", "Open Discord", function()
        setclipboard(Flux.Discord)
        Flux.notify("Discord", "Invite copied - " .. Flux.Discord, 4)
    end },
    { "button", "Unload", function()
        Library:Unload()
    end },
})

if SaveManager then
    SaveManager:LoadAutoloadConfig()
end

-- ───────────────────────── Bind state ─────────────────────────
-- A Hold picker is pull-only: Obsidian runs Callback from the picker's own click, never from the
-- bound key being down. Anything a feature gates on that callback is waiting for a click the
-- player is told not to make, so the held state is read off the picker once a frame - which also
-- covers mouse buttons and modifiers, neither of which a raw KeyCode comparison can see.
local RunService = game:GetService("RunService")
local bindWasHeld = {}

local bindReaders = {
    aimbot_active = function(held)
        F.aimbot_active = held
    end,
    ragebot_active = function(held)
        F.ragebot_active = held
    end,
    fake_position_keybind = function(held, wasHeld)
        if held and not wasHeld then
            Engine.setFakePosition(not Engine.fakePos.Enabled)
            local state = "Disabled"
            if Engine.fakePos.Enabled then
                state = "Enabled (" .. tostring(Engine.fakePos.Depth) .. " studs underground)"
            end
            Flux.notify("Fake Position", state, 2)
        end
    end,
}

local bindConn = RunService.RenderStepped:Connect(function()
    for id, reader in pairs(bindReaders) do
        local picker = Options[id]
        local held = false
        if picker then
            -- An older config can name a key the enum no longer has, and GetState indexes it raw.
            local ok, state = pcall(picker.GetState, picker)
            held = ok and state == true
        end
        local wasHeld = bindWasHeld[id] == true
        bindWasHeld[id] = held
        reader(held, wasHeld)
    end
end)

-- The engine stops with its own teardown; this loop belongs to the menu, so the menu unhookes it.
Library:OnUnload(function()
    pcall(function() bindConn:Disconnect() end)
end)

local MenuAPI = {
    Library = Library,
    Window = Window,
    Tabs = Tabs,
    state = { cosmetic = cosmeticState, inventory = inventoryState, custom = customDef },
    refreshCatalog = refreshCatalog,
}


return MenuAPI
end)()
Flux.Menu = Menu

-- ══════════════════════════════════════════════════════════════════════
--  §4  BOOT
-- ══════════════════════════════════════════════════════════════════════
--[[
    §4  Boot and teardown.
]]

local MenuAPI = Flux.Menu

-- Without the interface there is nothing to drive the engine, but the halves already
-- loaded still hold state, so leave a teardown path that a second execution can call.
if type(MenuAPI) ~= "table" then
    warn("[Flux] menu unavailable - features stay off until the interface loads")
    getgenv().FluxCleanup = function()
        pcall(Flux.Spoof.shutdown)
        pcall(Flux.Engine.shutdown)
        getgenv().FluxCleanup = nil
        Flux.Running = false
    end
    return
end

Flux.Spoof.setLibrary(MenuAPI.Library)

local cleaning = false
local function cleanup()
    if cleaning then
        return
    end
    cleaning = true
    pcall(Flux.Spoof.shutdown)
    pcall(Flux.Engine.shutdown)
    pcall(function()
        if MenuAPI.Library and MenuAPI.Library.Unloaded ~= true then
            MenuAPI.Library:Unload()
        end
    end)
    getgenv().FluxCleanup = nil
    Flux.Running = false
end

getgenv().FluxCleanup = cleanup
Flux.Cleanup = cleanup
Flux.Running = true

-- Library:Unload runs the registered callbacks and destroys every element it built.
MenuAPI.Library:OnUnload(cleanup)

Flux.notify(Flux.Brand, "loaded - RightShift toggles the menu", 6)
