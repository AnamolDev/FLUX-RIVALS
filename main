local Menu = (function()
--[[
    §3  Flux Rivals menu (official Obsidian interface).

    Row ids double as engine flag names, so every plain row writes flags.<id> and the
    SaveManager config stays readable. Rows that drive a state table pass an explicit setter.
]]

local repo = "https://raw.githubusercontent.com/deividcomsono/Obsidian/main/"
local okLib, Library = pcall(function()
    return loadstring(game:HttpGet(repo .. "Library.lua"))()
end)
if not okLib or type(Library) ~= "table" then
    warn("[Flux] Obsidian interface unavailable: " .. tostring(Library))
    return
end

local okTheme, ThemeManager = pcall(function()
    return loadstring(game:HttpGet(repo .. "addons/ThemeManager.lua"))()
end)
if not okTheme then
    ThemeManager = nil
end
local okSave, SaveManager = pcall(function()
    return loadstring(game:HttpGet(repo .. "addons/SaveManager.lua"))()
end)
if not okSave then
    SaveManager = nil
end

Flux.Library = Library

local Options = Library.Options
local Toggles = Library.Toggles
local Engine = Flux.Engine
local Spoof = Flux.Spoof
local F = Engine.flags
local M = Engine.movement
local P = Engine.fakePos

local presets = Engine.presets
local skyboxNames = {}
for name in pairs(presets.skybox) do
    skyboxNames[#skyboxNames + 1] = name
end
table.sort(skyboxNames)

local hitSoundNames = { "Custom ID" }
for name in pairs(presets.hitSound) do
    hitSoundNames[#hitSoundNames + 1] = name
end
table.sort(hitSoundNames)

local killSoundNames = { "Custom ID" }
for name in pairs(presets.killSound) do
    killSoundNames[#killSoundNames + 1] = name
end
table.sort(killSoundNames)

local Window = Library:CreateWindow({
    Title = Flux.Brand,
    Footer = "discord.gg/pGZCyjeTfU",
    Icon = Flux.Logo,
    NotifySide = "Right",
    ShowCustomCursor = true,
    AutoShow = true,
    Center = true,
    ToggleKeybind = Enum.KeyCode.RightShift,
})
Flux.Window = Window
Flux.PaintLogo(Window)

local Tabs = {}
local function tab(name, icon)
    local created = Window:AddTab(name, icon)
    Tabs[name] = created
    return created
end

-- ───────────────────────── row builders ─────────────────────────
-- A row is { kind, id, text, ...args, [setter] }. Missing setter writes flags.<id>.
local function setterFor(id, setter)
    if setter then
        return setter
    end
    return function(value)
        F[id] = value
    end
end

local function addToggle(box, row)
    local id, text, default, set = row[2], row[3], row[4], row[5]
    box:AddToggle(id, {
        Text = text,
        Default = default == true,
        Callback = Flux.guard(setterFor(id, set), text),
    })
end

local function addSlide(box, row)
    local id, text, default, min, max, round, set = row[2], row[3], row[4], row[5], row[6], row[7], row[8]
    box:AddSlider(id, {
        Text = text,
        Default = default,
        Min = min,
        Max = max,
        Rounding = round or 0,
        Suffix = row.suffix,
        Callback = Flux.guard(setterFor(id, set), text),
    })
end

local function addPick(box, row)
    local id, text, values, default, set = row[2], row[3], row[4], row[5], row[6]
    box:AddDropdown(id, {
        Text = text,
        Values = values,
        Default = default or values[1],
        Searchable = row.search,
        Callback = Flux.guard(setterFor(id, set), text),
    })
end

local function addType(box, row)
    local id, text, default, set = row[2], row[3], row[4], row[5]
    box:AddInput(id, {
        Text = text,
        Default = default or "",
        Finished = true,
        Numeric = row.numeric,
        Placeholder = row.hint or "",
        Callback = Flux.guard(setterFor(id, set), text),
    })
end

local function addTint(box, row)
    local id, text, default, set = row[2], row[3], row[4], row[5]
    box:AddLabel(text):AddColorPicker(id, {
        Title = text,
        Default = default or Color3.new(1, 1, 1),
        Callback = Flux.guard(setterFor(id, set), text),
    })
end

local function addBind(box, row)
    local id, text, default, mode, set = row[2], row[3], row[4], row[5], row[6]
    box:AddLabel(text):AddKeyPicker(id, {
        Text = text,
        Default = default or "None",
        Mode = mode or "Toggle",
        Callback = Flux.guard(setterFor(id, set), text),
    })
end

local function addPress(box, row)
    return box:AddButton({
        Text = row[2],
        Func = Flux.guard(row[3], row[2]),
    })
end

local function addNote(box, row)
    box:AddLabel(row[2], true)
end

local function addDivider(box)
    box:AddDivider()
end

local BUILDERS = {
    toggle = addToggle,
    slider = addSlide,
    drop = addPick,
    input = addType,
    color = addTint,
    key = addBind,
    button = addPress,
    label = addNote,
    divider = addDivider,
}

local function groupbox(t, side, title, icon, rows)
    local box = t["Add" .. side .. "Groupbox"](t, title, icon)
    for _, row in ipairs(rows) do
        local builder = BUILDERS[row[1]]
        if builder then
            builder(box, row)
        else
            warn("[Flux] unknown row kind: " .. tostring(row[1]))
        end
    end
    return box
end

local function left(t, title, icon, rows)
    return groupbox(t, "Left", title, icon, rows)
end

local function right(t, title, icon, rows)
    return groupbox(t, "Right", title, icon, rows)
end

-- ───────────────────────── helper callbacks ─────────────────────────
local function writePair(keys)
    return function(value)
        for _, key in ipairs(keys) do
            F[key] = value
        end
    end
end

local function writeField(target, key)
    return function(value)
        target[key] = value
    end
end

local musicState = { Opened = false, Visible = false }

local function musicFrame()
    local player = Engine.music
    return player and player.MainFrame
end

