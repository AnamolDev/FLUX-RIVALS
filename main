-- ───────────────────────── Spoofers ─────────────────────────
local spoofTab = tab("Spoofers", "user-cog")
local backend = Spoof.backend
-- The engine's service locals live inside the engine function and the menu's own are declared below,
-- so the spoof frame carries its own references.
local spoofPlayer = game:GetService("Players").LocalPlayer
local spoofHeartbeat = game:GetService("RunService").Heartbeat

--[[
    The profile numbers used to be written through the game's own data module, and the game answers
    that by putting its real values straight back. What the client does get to decide is the
    attributes on its own Player and the name on itself and its character - and the only way to keep
    those is to write them again whenever the game moves them, which is what the frame below does.
]]
local spoofEntries = {
    { on = false, value = 100, attribute = "Level", captured = false, original = nil },
    { on = false, value = 100, attribute = "StatisticDuelsWinStreak", captured = false, original = nil },
    { on = false, value = 2000, attribute = "DisplayELO", captured = false, original = nil },
    { on = false, value = 1, attribute = "DisplayELOLeaderboardRanking", captured = false, original = nil },
}
local spoofName = { on = false, text = "" }

local function spoofApply(player, entry)
    if not entry.captured then
        entry.captured = true
        entry.original = player:GetAttribute(entry.attribute)
    end
    if player:GetAttribute(entry.attribute) ~= entry.value then
        player:SetAttribute(entry.attribute, entry.value)
    end
end

local function spoofGiveBack(player, entry)
    if not entry.captured then
        return
    end
    entry.captured = false
    local original = entry.original
    entry.original = nil
    if player:GetAttribute(entry.attribute) ~= original then
        player:SetAttribute(entry.attribute, original)
    end
end

local function spoofFrame()
    local player = spoofPlayer
    for _, entry in ipairs(spoofEntries) do
        if entry.on then
            pcall(spoofApply, player, entry)
        end
    end

    local name = spoofName.text
    if spoofName.on and name ~= "" then
        if player.DisplayName ~= name then
            pcall(function()
                player.DisplayName = name
            end)
        end
        pcall(function()
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            -- A respawn hands over a fresh Humanoid, whose display name is the real one again.
            if hum and hum.DisplayName ~= name then
                hum.DisplayName = name
            end
        end)
    end
end

local spoofConn = spoofHeartbeat:Connect(spoofFrame)

Library:OnUnload(function()
    pcall(function()
        spoofConn:Disconnect()
    end)
    local player = spoofPlayer
    for _, entry in ipairs(spoofEntries) do
        pcall(spoofGiveBack, player, entry)
    end
end)

local function spoofValue(box, title, entry, placeholder)
    box:AddToggle("FluxSpoof_" .. entry.attribute, {
        Text = title,
        Default = entry.on,
        Callback = Flux.guard(function(value)
            entry.on = value == true
            if not entry.on then
                spoofGiveBack(spoofPlayer, entry)
            end
        end, title),
    })
    box:AddInput("FluxSpoofValue_" .. entry.attribute, {
        Text = title .. " value",
        Placeholder = placeholder,
        Numeric = true,
        Finished = true,
        Default = tostring(entry.value),
        Callback = Flux.guard(function(value)
            local number = tonumber(value)
            assert(number and number == number and math.abs(number) < 1e12, "Enter a finite number")
            entry.value = math.max(0, math.floor(number))
            if entry.on then
                pcall(spoofApply, spoofPlayer, entry)
            end
        end, title),
    })
end

-- The name the game shows is decided by the hub's own identity hook, and that hook reads the spoof
-- config: writing the two properties on the player is not enough on its own, because the labels the
-- game already built are refreshed from the config the hook was given.
local function spoofIdentity()
    local name = spoofName.on and spoofName.text or ""
    Spoof.config.SpoofedName = name
    Spoof.config.SpoofedDisplayName = name
    pcall(function()
        backend:SetIdentity(name ~= "")
    end)
end

left(spoofTab, "Identity", "id-card", {
    { "input", "FluxSpoofName", "Name", "", function(value)
        spoofName.text = value
        spoofIdentity()
    end },
    { "toggle", "FluxSpoofNames", "Spoof my name", false, function(value)
        spoofName.on = value == true
        spoofIdentity()
    end },
    { "divider" },
    { "toggle", "status_spoof_enabled", "Spoof player status" },
    { "input", "status_spoof_value", "Status text", "" },
})

local numbersBox = right(spoofTab, "Profile numbers", "hash", {
    { "label", "Written to your own player, the way the game reads it back." },
})
spoofValue(numbersBox, "Level", spoofEntries[1])
spoofValue(numbersBox, "Win streak", spoofEntries[2])
spoofValue(numbersBox, "ELO", spoofEntries[3])
spoofValue(numbersBox, "Leaderboard rank", spoofEntries[4])

-- ───────────────────────── Cosmetics ─────────────────────────
local cosmetics = tab("Cosmetics", "shirt")
local KINDS = { "Skin", "Wrap", "Charm", "Finisher", "Emote" }
local RARITIES = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Contraband" }
local cosmeticState = { weapon = nil, kind = "Skin", selection = nil, page = 1, query = "", entries = {} }

local function api()
    return Spoof.api()
end

local function pageValues()
    local values = {}
    local pages = math.max(1, math.ceil(#cosmeticState.entries / 60))
    cosmeticState.page = math.clamp(cosmeticState.page, 1, pages)
    for index = (cosmeticState.page - 1) * 60 + 1, math.min(cosmeticState.page * 60, #cosmeticState.entries) do
        values[#values + 1] = cosmeticState.entries[index].Name
    end
    return values, pages
end

local function refreshCatalog()
    if not Spoof.runtime.FluxApi or not cosmeticState.weapon then
        return
    end
    cosmeticState.entries = api().CascadeCatalog(cosmeticState.kind, cosmeticState.weapon, cosmeticState.query)
    local values, pages = pageValues()
    Options.FluxCosmetic:SetValues(values)
    cosmeticState.selection = values[1]
    if values[1] then
        Options.FluxCosmetic:SetValue(values[1])
    end
    Flux.notify("Catalog", "Page " .. cosmeticState.page .. " / " .. pages .. " - " .. #cosmeticState.entries .. " items", 3)
end

left(cosmetics, "Skin changer", "brush", {
    { "toggle", "FluxUnlockAll", "Unlock all cosmetics", false, function(value)
        backend.Unlock = value
        backend:RefreshInventory()
    end },
    { "toggle", "FluxWeaponOwnership", "Spoof weapon ownership", false, function(value)
        local ok, why = api().SetWeaponOwnership(value)
        assert(ok ~= false, tostring(why))
    end },
    { "drop", "FluxWeapon", "Weapon", {}, nil, function(value)
        cosmeticState.weapon = value
        cosmeticState.page = 1
        refreshCatalog()
    end },
    { "drop", "FluxCosmeticKind", "Type", KINDS, "Skin", function(value)
        cosmeticState.kind = value
        cosmeticState.page = 1
        refreshCatalog()
    end },
    { "input", "FluxCosmeticQuery", "Search", "", function(value)
        cosmeticState.query = value
        cosmeticState.page = 1
        refreshCatalog()
    end },
    { "button", "Load catalog", function()
        local values = {}
        for _, entry in ipairs(api().CascadeCatalog("Weapon")) do
            values[#values + 1] = entry.Name
        end
        Options.FluxWeapon:SetValues(values)
        if values[1] then
            cosmeticState.weapon = cosmeticState.weapon or values[1]
            Options.FluxWeapon:SetValue(cosmeticState.weapon)
        end
        refreshCatalog()
    end },
})

right(cosmetics, "Equip", "wand-2", {
    { "drop", "FluxCosmetic", "Cosmetic", {}, nil, function(value)
        cosmeticState.selection = value
    end },
    { "button", "Previous page", function()
        cosmeticState.page = math.max(1, cosmeticState.page - 1)
        refreshCatalog()
    end },
    { "button", "Next page", function()
        cosmeticState.page = cosmeticState.page + 1
        refreshCatalog()
    end },
    { "button", "Equip selected", function()
        assert(cosmeticState.selection, "Choose a cosmetic")
        api().CascadeEquip(cosmeticState.weapon, cosmeticState.selection, cosmeticState.kind)
    end },
    { "button", "Restore this slot", function()
        api().CascadeEquip(cosmeticState.weapon, "None", cosmeticState.kind)
    end },
    { "button", "Reset all cosmetics", function()
        api().CascadeReset()
    end },
})

