-- ── engine export surface ────────────────────────────────────────────────
-- Only what the menu and the boot teardown need; the engine keeps driving itself.
local EngineAPI = {
    flags = flags,
    state = fluxState,
    fakePos = fakePos,
    movement = movementState,
    staff = staffDetectorState,
    presets = {
        skybox = SKYBOX_PRESETS,
        hitSound = HIT_SOUND_PRESETS,
        killSound = KILL_SOUND_PRESETS,
    },
    setFakePosition = setFakePosition,
    fpsBoost = setFpsBoost,
    updateGhostVisualizer = updateGhostVisualizer,
    applySkybox = applySkybox,
    playAnimDesync = playAnimDesync,
    stopAnimDesync = stopAnimDesync,
    redraw = initProceduralDrawings,
    music = MusicPlayer,
    openMusicPlayer = initMusicPlayer,
    -- The tick only scans while a feature consumes the result; a one-off reader asks for it.
    scanTarget = function() return get_target(true) end,
}

function EngineAPI.shutdown()
    pcall(function() stepConn:Disconnect() end)
    pcall(function() renderConn:Disconnect() end)
    pcall(setFpsBoost, false)
    pcall(function()
        if speedConn then
            speedConn:Disconnect()
        end
        if speedHum and speedBase then
            speedHum.WalkSpeed = speedBase
        end
    end)
    movementState.WalkSpeedEnabled = false
    pcall(function()
        if shared then
            shared.FluxMusicPlayer = nil
        end
    end)
end

return EngineAPI
end)()
Flux.Engine = Engine

