--// OBDUSCATED BY NIGER

return(function(...)local V,H do local k=(1617)-(1490) local WW=(255*5)/(5) local J=function(x)return x end local F={} for i=0,64,1 do F[i]={} for j=0,64,1 do F[i][j]=0 end end local L={33,64,35,36} local F={37,94,38,42} local w={40,41,95,43} local r={45,61,91,93} local r={} local P=1 for _,arr in ipairs({L,F,w,r}) do for i=1,#arr,1 do r[P]=string.char(tonumber(arr[i]) or 0) P=P+1 end end r=table.concat(r) local R=(4788)-(4713) local T=76 local S=R+T local function E(a,b) if F[a] and (F[a][b] and F[a][b]~=0) then return F[a][b] end local kk=0 for bit=0,7,1 do local J=a/2+b/2 if J~=math.floor(J) then kk=kk+(2)^bit end a=math.floor(a/2) b=math.floor(b/2) end if a<256 and b<256 then F[a]=F[a] or {} F[a][b]=kk end return kk end local U={} for i=1,#r,1 do U[string.sub(r,i,i)]=i-1 end local function BS(ch) return U[ch] or 0 end local YU="&%&^*&&)&$&^|^&&)&^***!&]*#*%^!&]&)&[*%^%&]^#&@*)|^)%#^!&@%[&)|*%&^*(*%%$&]&-&]*#$$|%**#&]*^&[&%#!&@&[&%#!&@&)*##!&=&]*&&^&=&^&[*%#[|%&&@*&&]*#&)*%&^&%^#&^*$&]&-*&&^*#|%&&)&-*%&^*#&)&[&*|%^&&&&&^&$*%|^$&^*%^$&-&)&%&)&[&*%=*^&-*%&)*!&-&)&^*#%^&[&@&#&-&^&%|#-%)&$&]&[$=&^#[^*&^&@*!&]&[#-%%&^*$&$*#&)*!*%&)&]&[$=|%)&[*!*^*%%^&[&%&^&%|&^*$*!^]&)&=&@&*&^*$|^$**&^&^*!*$#!*%&(&^#!&$*^*#*#&^&[*%#!&=&@*!#!&@&*&@&)&[#!&@&&*%&^*##!&@#!&[&^**#!&=&@*%&$&(#!&-&]&@&%*$#[|^*$^%)$&$$^@%#%^^)&$*)^@&&^#$!$@$^$)%[$!*@%@*(%&%=%@$)&+$)%$&)*&^)|%#&@*%|%%&^*$&$&^&[&%&@&[*%^#&^&=&]*&&)&[&*|*$*%*#&]&#&^|&*&^*%&)&%&^&[*%&)*%*)|^^*$&^*#^$&^*#*&&^*#^!*#&]*%&]&$&]&-|&$&]&[*%*#&@&$*%|&*&^*%%%&@*%&@|%%$!^#&-$%%+%[%]*^^!|%)&[&%&)&$&@*%&]*#|%(*^&=|*%&&&)&[|^#&]*%&@*%&)&]&[%=&)&[|^]&-&@*$*%^$&-&)&%&)&[&*|&^&=&)*%*%&^*#|^]&-&@*$*%^!&-&@*)&^&%%@*%%#*)^$&]*^&[&%|^!&-&^&@*$&^#!*!&@*$*$#!&@#!&(&@&[&%&-&^*##!&&*^&[&$*%&)&]&[#!*%&]#!#^*$#@|*$$^*&%@$$&]%=%(%%*#%*$)&=^$^$*_%^%+^_%@%=^!^^^$&*$&%+*&$@&&%(%#%]**%+^@%(*!$&%+%-^$&*%@*$^)%)%$&=^)%=&-&#%@$!$&%]%&&*^^*$%=**%@$&%_|&(&$&)$@^(&)^!^^%&&_*#&#^$$!%=%*^(&*%^^(^$$!&)^$*)%@^**)*!&]^^%#&&&-%=&]$!$)&]$@&-%)%=^!%**^^_&[&#%^%@$$^)$!|^]&]